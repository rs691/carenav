# LLM
OPENAI_API_KEY=sk-...
OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# Azure (production target)
AZURE_OPENAI_ENDPOINT=https://<resource>.openai.azure.com/
AZURE_OPENAI_KEY=...
AZURE_OPENAI_DEPLOYMENT=gpt-4o

# Vector DB — Qdrant Cloud free tier (or http://localhost:6333 via docker compose)
QDRANT_URL=https://<cluster>.qdrant.io
QDRANT_API_KEY=...

# Database — Supabase Postgres (optional for local dev; leave empty for in-memory sessions)
SUPABASE_URL=https://<project>.supabase.co
SUPABASE_SERVICE_KEY=...
# New Supabase projects use asymmetric JWTs (ES256) — JWKS is used automatically from:
#   {SUPABASE_URL}/auth/v1/.well-known/jwks.json
# Optional override:
# SUPABASE_JWKS_URL=https://<project>.supabase.co/auth/v1/.well-known/jwks.json
# Legacy HS256 only (older projects):
SUPABASE_JWT_SECRET=
# asyncpg accepts postgresql:// ; SQLAlchemy-style postgresql+asyncpg:// is normalized automatically
DATABASE_URL=postgresql+asyncpg://postgres:<password>@db.<project>.supabase.co:5432/postgres

# Auth
JWT_SECRET=change-me-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRE_MINUTES=480
CORS_ORIGINS=http://localhost:3000

# App
APP_ENV=development
LOG_LEVEL=INFO
